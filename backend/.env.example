# Local development only. PowerShell scripts set the defaults.
DATABASE_URL=postgresql+psycopg://weijin:local-development-only@127.0.0.1:55438/weijin
APP_ENV=development
MODEL_PROVIDER=deepseek
# Copy this file to backend/.env. Never commit .env or send API keys in chat.
# Default service: DeepSeek. Set the key locally; the model is configurable.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional legacy OpenAI configuration (only used with MODEL_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=120
# Existing template buttons remain explicit, no-cost mock demonstrations.
